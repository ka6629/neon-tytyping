{
  "manifest_version": 3,
  "name": "ネオンタイピング自動タイパー",
  "description": "ネオンタイピングのページで超高速自動タイピングを行う Chrome 拡張機能です。",
  "version": "1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "自動タイパー"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["https://otonasi-muonn.github.io/typing_game/*"],
  "content_scripts": [
    {
      "matches": ["https://otonasi-muonn.github.io/typing_game/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
